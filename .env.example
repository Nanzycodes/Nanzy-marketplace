# ========================
# Nanzy Clothes Environment Variables
# ========================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for Auth + Database)
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack (required for real payments)
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use TEST keys while developing
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Optional
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=orders@nanzyclothes.com
